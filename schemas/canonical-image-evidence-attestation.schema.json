{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rerevved.local/schemas/canonical-image-evidence-attestation.schema.json",
  "title": "ReRevved canonical-image evidence attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifact",
    "claimBoundary",
    "image",
    "checks",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifact": { "const": "canonical-image-evidence-attestation" },
    "claimBoundary": {
      "const": "Canonical-image evidence validation, not retail derivation validation."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256", "imageBase", "processor"],
      "properties": {
        "name": { "const": "rerevved_image.bin" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "imageBase": { "$ref": "common.schema.json#/$defs/address" },
        "processor": { "const": "PowerPC:BE:32:default" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "entities", "addresses", "status"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "entities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RVA-(?:SYM|FLD|VTBL|REL)-[0-9]{4}$"
            }
          },
          "addresses": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/address" }
          },
          "status": { "enum": ["pass", "fail"] }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "total"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
